{
  "name": "cocos-mcp-inspector",
  "displayName": "Cocos MCP Inspector",
  "description": "Cocos Creator 运行时审查面板 — 在 Cursor/VS Code 中连接 mcp-inspector-bridge",
  "version": "0.1.8",
  "publisher": "firekula",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "onCommand:cocosInspector.open",
    "onCommand:cocosInspector.openPreview",
    "onCommand:cocosInspector.pickInstance",
    "onCommand:cocosInspector.openDevTools",
    "workspaceContains:**/project.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cocosInspector.open",
        "title": "Cocos Inspector: 打开预览面板",
        "category": "Cocos"
      },
      {
        "command": "cocosInspector.connect",
        "title": "Cocos Inspector: 连接 Bridge",
        "category": "Cocos"
      },
      {
        "command": "cocosInspector.openPreview",
        "title": "Cocos Inspector: 在编辑器打开预览",
        "category": "Cocos"
      },
      {
        "command": "cocosInspector.pickInstance",
        "title": "Cocos Inspector: 选择 Bridge 实例",
        "category": "Cocos"
      },
      {
        "command": "cocosInspector.openDevTools",
        "title": "Cocos Inspector: 打开预览页 / DevTools",
        "category": "Cocos"
      },
      {
        "command": "cocosInspector.configureMcp",
        "title": "Cocos Inspector: 配置 Cursor MCP",
        "category": "Cocos"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cocos-inspector",
          "title": "Cocos Inspector",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cocos-inspector": [
        {
          "type": "webview",
          "id": "cocosInspector.panel",
          "name": "预览面板"
        }
      ]
    },
    "configuration": {
      "title": "Cocos MCP Inspector",
      "properties": {
        "cocosInspector.bridgePort": {
          "type": "number",
          "default": 0,
          "description": "手动指定 Bridge 端口（0 = 自动扫描 4456-4556）"
        },
        "cocosInspector.useProbeProxy": {
          "type": "boolean",
          "default": false,
          "description": "侧栏 iframe 预览走探针代理（仅侧栏内嵌预览时有效；编辑器预览始终直连 Creator 预览端口）"
        },
        "cocosInspector.previewInEditor": {
          "type": "boolean",
          "default": true,
          "description": "将游戏预览显示在编辑器区域（代码区），侧栏仅保留节点树与属性面板"
        },
        "cocosInspector.previewMode": {
          "type": "string",
          "enum": [
            "simpleBrowser",
            "webview"
          ],
          "default": "simpleBrowser",
          "description": "编辑器预览加载方式：simpleBrowser（推荐，直接加载预览页）或 webview（iframe 嵌入）"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p . && node scripts/copy-mcp-client.js",
    "watch": "tsc -w -p ."
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "ws": "^8.20.0"
  }
}
